{
    "name": "@cica/nunjucks-govuk",
    "version": "0.1.0",
    "description": "Nunjucks template-engine factory for CICA web apps with GOV.UK + MoJ frontend asset resolution (no hardcoded node_modules paths).",
    "type": "module",
    "main": "src/index.js",
    "exports": {
        ".": "./src/index.js"
    },
    "engines": {
        "node": ">=24.15.0",
        "npm": ">=11.12.1"
    },
    "files": [
        "src",
        "!src/**/*.test.js"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CriminalInjuriesCompensationAuthority/cica-platform.git",
        "directory": "packages/nunjucks-govuk"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "scripts": {
        "test": "c8 node --test",
        "coverage:html": "c8 report --reporter=html",
        "lint": "biome check",
        "lint:check": "biome check",
        "lint:fix": "biome check --write"
    },
    "peerDependencies": {
        "@ministryofjustice/frontend": ">=5",
        "express": ">=4",
        "nunjucks": "^3.2.4"
    },
    "devDependencies": {
        "@ministryofjustice/frontend": "^12.0.0",
        "express": "^5.0.0",
        "nunjucks": "^3.2.4"
    },
    "license": "MIT"
}
