{
    "name": "@cica/logger",
    "version": "0.1.0",
    "description": "Shared pino/pino-http logger factory for CICA Node.js services (env-driven redaction, correlation id, dev pretty-print).",
    "type": "module",
    "main": "src/index.js",
    "exports": {
        ".": "./src/index.js"
    },
    "engines": {
        "node": ">=24.15.0",
        "npm": ">=11.12.1"
    },
    "files": [
        "src",
        "!src/**/*.test.js"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CriminalInjuriesCompensationAuthority/cica-platform.git",
        "directory": "packages/logger"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "scripts": {
        "test": "c8 node --test",
        "coverage:html": "c8 report --reporter=html",
        "lint": "biome check",
        "lint:check": "biome check",
        "lint:fix": "biome check --write"
    },
    "dependencies": {
        "pino": "^9.0.0",
        "pino-http": "^10.0.0"
    },
    "peerDependencies": {
        "pino-pretty": "^13.0.0"
    },
    "peerDependenciesMeta": {
        "pino-pretty": {
            "optional": true
        }
    },
    "devDependencies": {
        "pino-pretty": "^13.1.3"
    },
    "license": "MIT"
}
