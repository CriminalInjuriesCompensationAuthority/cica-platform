{
    "name": "cica-platform",
    "version": "0.0.0",
    "private": true,
    "description": "CICA shared runtime libraries (@cica/*): logger, express-baseline, nunjucks-govuk. npm-workspaces monorepo; each package is published and imported independently.",
    "type": "module",
    "engines": {
        "node": ">=24.15.0",
        "npm": ">=11.12.1"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "test": "npm run test --workspaces --if-present",
        "coverage:html": "npm run coverage:html --workspaces --if-present",
        "lint": "biome check",
        "lint:check": "biome check",
        "lint:fix": "biome check --write",
        "format": "biome format --write",
        "audit:ci": "npm audit --audit-level=high --omit=dev",
        "prepush": "npm test && npm run lint:check && npm run audit:ci",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "c8": "^12.0.0",
        "husky": "^9.1.7"
    },
    "license": "MIT"
}
